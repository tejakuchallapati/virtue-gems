# Gmail SMTP (use an App Password — not your regular Gmail password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=virtuegems777@gmail.com
SMTP_PASS=your-gmail-app-password

# Where all notifications are delivered
NOTIFY_EMAIL=virtuegems777@gmail.com
FROM_NAME=Virtue Gems

# Secret key for POST /api/notify (project update emails from the app)
NOTIFY_API_KEY=generate-a-long-random-string

# Public site URL — MUST match your Vercel primary domain (www redirects from apex)
# Set the same value in Vercel → Project → Settings → Environment Variables
NEXT_PUBLIC_SITE_URL=https://www.virtuegems.com

# Google Search Console HTML-tag verification (optional but recommended)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=paste-code-from-search-console

# Google Business Profile → Ask for reviews → copy review link
# Shows a verified "Review us on Google" button on the customer reviews section
# NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/your-business-id/review

# Optional: separate API origin if frontend and backend run on different hosts
# NEXT_PUBLIC_API_URL=https://api.virtuegems.com

# WhatsApp-first payments (shown on checkout, WhatsApp bills, admin copy-reply)
NEXT_PUBLIC_UPI_ID=virtuegems@upi
NEXT_PUBLIC_UPI_PAYEE_NAME=Virtue Gems
# NEXT_PUBLIC_BANK_DETAILS=Account: Virtue Gems, HDFC Bank, A/c 1234567890, IFSC HDFC0001234
# NEXT_PUBLIC_COD_ENABLED=false

# WhatsApp (country code + number, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=917396178039

# Production data, image storage, CRM and admin authentication (Supabase)
# Project Settings → API. Never expose the service-role key in client code.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images

# Optional only while running `npm run migrate:supabase` for the first owner.
# Remove INITIAL_ADMIN_PASSWORD from local/Vercel env after migration.
# INITIAL_ADMIN_EMAIL=owner@example.com
# INITIAL_ADMIN_PASSWORD=create-a-strong-temporary-password

# Legacy/local admin OTP fallback (used only when Supabase is not configured)
ADMIN_EMAIL=virtuegems777@gmail.com

# Legacy/local OTP signing secret
OTP_SECRET=generate-a-long-random-string

# SQLite database (optional — defaults to ./data/virtue-gems.db)
# DATABASE_DIR=/var/data/virtue-gems
# DATABASE_PATH=/var/data/virtue-gems/virtue-gems.db

# Phase 2 — payments (Razorpay — not required for WhatsApp-first launch)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Phase 2 — Google Analytics 4 (visitor traffic; reports live in analytics.google.com)
# Create a GA4 property → copy Measurement ID → set on Vercel Production → redeploy
# See docs/phase-2/analytics-qa.md
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
